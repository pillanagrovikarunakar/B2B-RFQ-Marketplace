						"body": {
							"mode": "raw",
							"raw": "{\n  \"product_name\": \"Invalid Status RFQ\",\n  \"description\": \"Testing invalid status value\",\n  \"quantity\": 10,\n  \"delivery_location\": \"Location\",\n  \"deadline\": \"2026-12-31T23:59:59Z\",\n  \"status\": \"INVALID_STATUS\"\n}"
